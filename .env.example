# Exactly two distinct admin emails; use unique passwords of at least 12 characters.
# Set these as server environment variables or in a local .env file.
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Production: absolute path on a persistent mounted volume, outside the app release.
# Copy the existing data/ contents (including uploads/) here before switching.
# Leave empty for local development using ./data.
DATA_DIR=

# Set to 1 only when one trusted HTTPS reverse proxy sits in front of the app.
TRUST_PROXY=0
